                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,5"
                                                Height="50"/>
                                        <Label x:Name="GameTitleText14"
                                               Content="Game 15"
                                               Foreground="White"
                                               FontSize="24"
                                               HorizontalContentAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,10"
                                               Height="45"
                                               Width="280"
                                               FontFamily="{StaticResource EarlyGameBoy}"/>
                                    </Grid>
                                </Panel>
                            </UniformGrid>
                        </Grid>
                        <Image Grid.Row="3"
                               x:Name="ScrollArrow_Down"
                               Source="/Assets/Images/Scroll-Arrow.gif"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               RenderTransformOrigin="50%,50%"
                               gif:AnimationBehavior.SourceUri="/Assets/Images/Scroll-Arrow.gif"/>
                        <Grid Grid.Row="4">
                            <Grid Grid.Row="0"
                                  Margin="100,25,100,25">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="3*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="Controls"
                                               Foreground="White"
                                               FontSize="22"
                                               FontFamily="{StaticResource EarlyGameBoy}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Border BorderThickness="0,0,1,0">
                                            <Border.BorderBrush>
                                                <DrawingBrush DestinationRect="0,0,16,8" TileMode="Tile">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#777">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,50,50"/>
                                                                        <RectangleGeometry Rect="50,50,50,50"/>
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*"/>
                                                    <RowDefinition Height="1*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Up Control -->
                                                <Grid Grid.Row="0"
                                                      Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Up Key -->
                                                    <Grid Grid.Column="0"
                                                          Margin="5,0">
                                                        <Ellipse Fill="#777"
                                                                 Height="50"
                                                                 Width="50"
                                                                 StrokeThickness="2"
                                                                 Stroke="#777"
                                                                 Margin="4,6,0,0"/>
                                                        <Ellipse Fill="#000"
                                                                 Height="48"
                                                                 Width="48"
                                                                 StrokeThickness="4"
                                                                 Stroke="#777"
                                                                 Margin="0,0,4,6"/>
                                                        <LayoutTransformControl Margin="0,0,14,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <LayoutTransformControl.LayoutTransform>
                                                                <RotateTransform Angle="270"/>
                                                            </LayoutTransformControl.LayoutTransform>
                                                            <TextBlock Text="&#10132;" Foreground="White" FontSize="30" FontFamily="{StaticResource EarlyGameBoy}"/>
                                                        </LayoutTransformControl>
                                                    </Grid>
                                                    <!-- Up Text -->
                                                    <Grid Grid.Column="1"
                                                          Margin="10,0">
                                                        <TextBlock Text="Up"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- Down Control -->
                                                <Grid Grid.Row="1"
                                                      Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Down Key -->
                                                    <Grid Grid.Column="0">
                                                        <Ellipse Fill="#777"
                                                                 Height="50"
                                                                 Width="50"
                                                                 StrokeThickness="2"
                                                                 Stroke="#777"
                                                                 Margin="4,6,0,0"/>
                                                        <Ellipse Fill="#000"
                                                                 Height="48"
                                                                 Width="48"
                                                                 StrokeThickness="4"
                                                                 Stroke="#777"
                                                                 Margin="0,0,4,6"/>
                                                        <LayoutTransformControl Margin="0,0,-6,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <LayoutTransformControl.LayoutTransform>
                                                                <RotateTransform Angle="90"/>
                                                            </LayoutTransformControl.LayoutTransform>
                                                            <TextBlock Text="&#10132;" Foreground="White" FontSize="30" FontFamily="{StaticResource EarlyGameBoy}"/>
                                                        </LayoutTransformControl>
                                                    </Grid>
                                                    <!-- Down Text -->
                                                    <Grid Grid.Column="1"
                                                          Margin="10,0">
                                                        <TextBlock Text="Down"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Border BorderThickness="1,0,1,0">
                                            <Border.BorderBrush>
                                                <DrawingBrush DestinationRect="8,0,16,8" TileMode="Tile">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#777">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,50,50"/>
                                                                        <RectangleGeometry Rect="50,50,50,50"/>
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*"/>
                                                    <RowDefinition Height="1*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Left Control -->
                                                <Grid Grid.Row="0"
                                                      Margin="20,5,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Left Key -->
                                                    <Grid Grid.Column="0"
                                                          Margin="5,0">
                                                        <Ellipse Fill="#777"
                                                                 Height="50"
                                                                 Width="50"
                                                                 StrokeThickness="2"
                                                                 Stroke="#777"
                                                                 Margin="4,6,0,0"/>
                                                        <Ellipse Fill="#000"
                                                                 Height="48"
                                                                 Width="48"
                                                                 StrokeThickness="4"
                                                                 Stroke="#777"
                                                                 Margin="0,0,4,6"/>
                                                        <LayoutTransformControl Margin="0,0,3,-3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <LayoutTransformControl.LayoutTransform>
                                                                <RotateTransform Angle="180"/>
                                                            </LayoutTransformControl.LayoutTransform>
                                                            <TextBlock Text="&#10132;" Foreground="White" FontSize="30" FontFamily="{StaticResource EarlyGameBoy}"/>
                                                        </LayoutTransformControl>
                                                    </Grid>
                                                    <!-- Left Text -->
                                                    <Grid Grid.Column="1"
                                                          Margin="10,0">
                                                        <TextBlock Text="Left"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- Right Control -->
                                                <Grid Grid.Row="1"
                                                      Margin="20,5,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Right Key -->
                                                    <Grid Grid.Column="0">
                                                        <Ellipse Fill="#777"
                                                                 Height="50"
                                                                 Width="50"
                                                                 StrokeThickness="2"
                                                                 Stroke="#777"
                                                                 Margin="4,6,0,0"/>
                                                        <Ellipse Fill="#000"
                                                                 Height="48"
                                                                 Width="48"
                                                                 StrokeThickness="4"
                                                                 Stroke="#777"
                                                                 Margin="0,0,4,6"/>
                                                        <LayoutTransformControl Margin="0,0,4,15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <LayoutTransformControl.LayoutTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </LayoutTransformControl.LayoutTransform>
                                                            <TextBlock Text="&#10132;" Foreground="White" FontSize="30" FontFamily="{StaticResource EarlyGameBoy}"/>
                                                        </LayoutTransformControl>
                                                    </Grid>
                                                    <!-- Right Text -->
                                                    <Grid Grid.Column="1"
                                                          Margin="10,0">
                                                        <TextBlock Text="Right"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Border BorderThickness="1,0,0,0">
                                            <Border.BorderBrush>
                                                <DrawingBrush DestinationRect="0,0,8,8" TileMode="Tile">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#777">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,50,50"/>
                                                                        <RectangleGeometry Rect="50,50,50,50"/>
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Border.BorderBrush>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*"/>
                                                    <RowDefinition Height="1*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Start Control -->
                                                <Grid Grid.Row="0"
                                                      Margin="20,5,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Start Key -->
                                                    <Grid Grid.Column="0">
                                                        <Ellipse Fill="#FF217300"
                                                                 Height="50"
                                                                 Width="50"
                                                                 StrokeThickness="5"
                                                                 Stroke="#FF217300"
                                                                 Margin="4,6,0,0"/>
                                                        <Ellipse Fill="#FF42E600"
                                                                 Height="48"
                                                                 Width="48"
                                                                 StrokeThickness="3"
                                                                 Stroke="#FF42E600"
                                                                 Margin="0,0,4,6"/>
                                                        <TextBlock Text="A"
                                                                   Foreground="White"
                                                                   FontSize="20"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,4"/>
                                                    </Grid>
                                                    <!-- Start Text -->
                                                    <Grid Grid.Column="1"
                                                          Margin="10,0">
                                                        <TextBlock Text="Select"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- Go Back Control -->
                                                <Grid Grid.Row="1"
                                                      Margin="20,5,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Start Key -->
                                                    <Grid Grid.Column="0">
                                                        <Ellipse Fill="#FF732121"
                                                                 Height="50"
                                                                 Width="50"
                                                                 StrokeThickness="5"
                                                                 Stroke="#FF732121"
                                                                 Margin="4,6,0,0"/>
                                                        <Ellipse Fill="#FFE64342"
                                                                 Height="48"
                                                                 Width="48"
                                                                 StrokeThickness="3"
                                                                 Stroke="#FFE64342"
                                                                 Margin="0,0,4,6"/>
                                                        <TextBlock Text="B"
                                                                   Foreground="White"
                                                                   FontSize="20"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,4"/>
                                                    </Grid>
                                                    <!-- Start Text -->
                                                    <Grid Grid.Column="1"
                                                          Margin="10,0">
                                                        <TextBlock Text="Go Back"
                                                                   Foreground="White"
                                                                   FontSize="18"
                                                                   FontFamily="{StaticResource EarlyGameBoy}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Column="1"
                      Background="Black"
                      Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="8*"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>
                    <!-- Game Image -->
                    <Grid Grid.Row="0"
                          Background="Black">
                        <Border BorderThickness="5"
                                BorderBrush="#FFF"
                                Margin="25">
                            <Image x:Name="NonGif_GameThumbnail"
                                   Source="/Assets/Images/ThumbnailPlaceholder.png"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <Border BorderThickness="5"
                                BorderBrush="#FFF"
                                Margin="25">
                            <Image x:Name="Gif_GameThumbnail"
                                   gif:AnimationBehavior.SourceUri="/Assets/Images/ThumbnailPlaceholder.png"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1"
                          Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.5*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1.25*"/>
                        </Grid.RowDefinitions>

                        <!-- Game Title -->
                        <Grid Grid.Row="0"
                              Margin="50,5">
                            <TextBlock x:Name="GameTitle"
                                       Text="Select A Game"
                                       Foreground="White"
                                       FontSize="32"
                                       TextWrapping="WrapWithOverflow"
                                       VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource EarlyGameBoy}"/>
                        </Grid>

                        <!-- Game Author(s) -->
                        <Grid Grid.Row="1"
                              Margin="50,0">
                            <TextBlock x:Name="GameAuthors"
                                       Text=""
                                       Foreground="#777"
                                       FontSize="14"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       TextWrapping="Wrap"
                                       LineHeight="15"/>
                        </Grid>

                        <!-- Game Tag(s) -->
                        <WrapPanel Grid.Row="2"
                                   Orientation="Horizontal"
                                   Margin="50,0">
                            <WrapPanel.Styles>
                                <Style Selector="Border">
                                    <Setter Property="Margin"
                                            Value="2"/>
                                </Style>
                            </WrapPanel.Styles>

                            <Border x:Name="GameTagBorder0"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag0"
                                           Text="Tag 1"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder1"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag1"
                                           Text="Tag 2"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder2"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag2"
                                           Text="Tag 3"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder3"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag3"
                                           Text="Tag 4"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder4"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag4"
                                           Text="Tag 5"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder5"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag5"
                                           Text="Tag 6"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder6"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag6"
                                           Text="Tag 7"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder7"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag7"
                                           Text="Tag 8"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>

                            <Border x:Name="GameTagBorder8"
                                    BorderThickness="1"
                                    BorderBrush="#777" utils:VisibilityExtensions.IsHidden="True">
                                <TextBlock x:Name="GameTag8"
                                           Text="Tag 9"
                                           Foreground="#777"
                                           FontSize="8"
                                           Margin="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="{StaticResource EarlyGameBoy}"/>
                            </Border>
                        </WrapPanel>
                    </Grid>
                    <!-- Game Description -->
                    <Grid Grid.Row="2"
                          Background="Black"
                          Margin="50,25">
                        <TextBlock x:Name="GameDescription"
                                   Text="Select a game using the joystick and by pressing A."
                                   Foreground="White"
                                   FontSize="14"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </Grid>
                    <!-- Game Start/Update -->
                    <Grid Grid.Row="3"
                          Background="Black"
                          Margin="25">
                        <ToggleButton x:Name="StartButton"
                                      Content="Checking For Updates..."
                                      Click="StartButton_Click"
                                      Theme="{StaticResource ToggleButtonStyle}"
                                      FontSize="20"
                                      Background="#222"
                                      Foreground="White"
                                      BorderBrush="White"
                                      BorderThickness="3"/>
                    </Grid>
                    <!-- Game Version -->
                    <Grid Grid.Row="4"
                          Background="Black"
                          Margin="25,0">
                        <TextBlock x:Name="VersionText"
                                   Text="0.0.0"
                                   Foreground="White"
                                   FontSize="10"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource EarlyGameBoy}"/>
                    </Grid>
                </Grid>
                <!-- Quarantine Warning -->
                <Grid x:Name="QuarantineWarning"
                      Grid.ColumnSpan="2"
                      ZIndex="100" IsVisible="False"
                      Background="#E6000000">
                    <Border Width="1360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Black"
                            BorderBrush="Red"
                            BorderThickness="6"
                            Padding="70,60">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Grid Width="84"
                                      Height="74"
                                      Margin="0,0,30,0"
                                      VerticalAlignment="Center">
                                    <Path Data="M 42,0 L 84,74 L 0,74 Z"
                                          Fill="Red"/>
                                    <TextBlock Text="!"
                                               Foreground="Black"
                                               FontSize="40"
                                               FontFamily="{StaticResource EarlyGameBoy}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,6"/>
                                </Grid>
                                <TextBlock Text="Quarantined Game"
                                           Foreground="Red"
                                           FontSize="44"
                                           FontFamily="{StaticResource EarlyGameBoy}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="QuarantineWarningGame"
                                       Text="GameName"
                                       Foreground="White"
                                       FontSize="30"
                                       Margin="0,50,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource EarlyGameBoy}"/>
                            <TextBlock Foreground="White"
                                       FontSize="24"
                                       LineHeight="46"
                                       Margin="0,50,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource EarlyGameBoy}">
                                <Run Text="This game"/>
                                <Run Text="may not work properly"
                                     Foreground="Red"/>
                                <Run Text="or is still experimental."/>
                            </TextBlock>
                            <TextBlock Foreground="White"
                                       FontSize="24"
                                       LineHeight="46"
                                       Margin="0,30,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource EarlyGameBoy}">
                                <Run Text="If it gets stuck,"/>
                                <Run Text="hold Exit for 3 seconds"
                                     Foreground="Red"/>
                                <Run Text="to close it."/>
                            </TextBlock>
                            <Grid Margin="0,70,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Margin="0,0,20,0"
                                        Padding="20,24"
                                        BorderBrush="#2ECC71"
                                        BorderThickness="4">
                                    <TextBlock Foreground="White"
                                               FontSize="22"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource EarlyGameBoy}">
                                        <Run Text="A / Start"
                                             Foreground="#2ECC71"/>
                                        <Run Text="Play"/>
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="20,24"
                                        BorderBrush="#777"
                                        BorderThickness="4">
                                    <TextBlock Foreground="White"
                                               FontSize="22"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource EarlyGameBoy}">
                                        <Run Text="B / Exit"
                                             Foreground="#AAA"/>
                                        <Run Text="Go Back"/>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

        </StackPanel>
    </Viewbox>
</Window>
