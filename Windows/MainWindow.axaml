                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,175,450"/>
                            <Ellipse x:Name="InputMenu_P2_Start"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
