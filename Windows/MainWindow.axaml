                                    <RotateTransform Angle="90"/>
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock x:Name="InputMenu_P2_Joy_DownText" Text=">" Foreground="White" FontSize="50" FontFamily="{StaticResource EarlyGameBoy}"/>
