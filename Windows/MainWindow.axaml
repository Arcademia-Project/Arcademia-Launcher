<Window x:Class="ArcademiaGameLauncher.Windows.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:ArcademiaGameLauncher.Utils"
        xmlns:local="clr-namespace:ArcademiaGameLauncher"
        xmlns:gif="clr-namespace:ArcademiaGameLauncher.Utils"
        xmlns:uc="clr-namespace:ArcademiaGameLauncher.UserControls"
        WindowStartupLocation="CenterScreen"
        WindowState="FullScreen"
        WindowDecorations="None"
        Background="Black"
        Title="Launcher">
    <!-- Declare the Launcher Version, Global Font and ToggleButton style -->
    <Window.Resources>
        <x:Double x:Key="LogicalSizeWidth">1920</x:Double>
        <x:Double x:Key="LogicalSizeHeight">1080</x:Double>
        <FontFamily x:Key="EarlyGameBoy">avares://Arcademia-Launcher/Fonts#Press Start 2P</FontFamily>
        <SolidColorBrush x:Key="ToggleButton.Static.Background"
                         Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="ToggleButton.Static.Border"
                         Color="#FF707070"/>
        <SolidColorBrush x:Key="ToggleButton.MouseOver.Background"
                         Color="#777"/>
        <SolidColorBrush x:Key="ToggleButton.MouseOver.Border"
                         Color="#FFF"/>
        <SolidColorBrush x:Key="ToggleButton.Pressed.Background"
                         Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="ToggleButton.Pressed.Border"
                         Color="#FF2C628B"/>
        <SolidColorBrush x:Key="ToggleButton.Disabled.Background"
                         Color="#222"/>
        <SolidColorBrush x:Key="ToggleButton.Disabled.Border"
                         Color="#FFF"/>
        <SolidColorBrush x:Key="ToggleButton.Disabled.Foreground"
                         Color="#FFF"/>
        <ControlTheme x:Key="ToggleButtonStyle"
                      TargetType="ToggleButton">
            <Setter Property="FontFamily"
                    Value="avares://Arcademia-Launcher/Fonts#Early GameBoy"/>
            <Setter Property="Background"
                    Value="{StaticResource ToggleButton.Static.Background}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource ToggleButton.Static.Border}"/>
            <Setter Property="Foreground"
                    Value="Black"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Padding"
                    Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Fill"
                                       Fill="Transparent"
                                       RenderTransformOrigin="0%,50%">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <ContentPresenter x:Name="contentPresenter"
                                              Focusable="False"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pressed /template/ Border#border">
                <Setter Property="Background"
                        Value="{StaticResource ToggleButton.Pressed.Background}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource ToggleButton.Pressed.Border}"/>
            </Style>
            <Style Selector="^:disabled /template/ Border#border">
                <Setter Property="Background"
                        Value="{StaticResource ToggleButton.Disabled.Background}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource ToggleButton.Disabled.Border}"/>
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#contentPresenter">
                <Setter Property="Foreground"
                        Value="{StaticResource ToggleButton.Disabled.Foreground}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#border">
                <Setter Property="Background"
                        Value="{StaticResource ToggleButton.MouseOver.Background}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource ToggleButton.MouseOver.Border}"/>
            </Style>
            <Style Selector="^:checked /template/ Border#border">
                <Setter Property="Background"
                        Value="{StaticResource ToggleButton.MouseOver.Background}"/>
                <Setter Property="BorderBrush"
                        Value="{StaticResource ToggleButton.MouseOver.Border}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <StackPanel Background="Black">
            <!-- Template Element For Programatically creating Gifs programatically -->
            <Grid Width="0"
                  Height="0"
                  x:Name="GifTemplateElement_Parent">
                <Image
                       gif:AnimationBehavior.SourceUri=""/>
            </Grid>

            <!-- Maintenance Screen -->
            <Grid x:Name="MaintenanceScreen" IsVisible="False"
                  Width="{StaticResource LogicalSizeWidth}"
                  Height="{StaticResource LogicalSizeHeight}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1"
                           Text="Undergoing Maintenance"
                           Foreground="White"
                           FontSize="40"
                           FontFamily="{StaticResource EarlyGameBoy}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="2"
                           Text="Please Wait"
                           Foreground="White"
                           FontSize="40"
                           FontFamily="{StaticResource EarlyGameBoy}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- Start Menu -->
            <Grid x:Name="StartMenu" IsVisible="False"
                  Width="{StaticResource LogicalSizeWidth}"
                  Height="{StaticResource LogicalSizeHeight}">
                <Grid.Background>
                    <SolidColorBrush Color="Black"/>
                </Grid.Background>
                <Canvas Background="#333">
                    <Image x:Name="StartMenu_Image"
                           Width="{StaticResource LogicalSizeWidth}"
                           Height="{StaticResource LogicalSizeHeight}"
                           gif:AnimationBehavior.SourceUri="/Assets/Images/StartMenu_Background.gif"
                           Stretch="UniformToFill"/>

                    <Rectangle x:Name="StartMenu_Rect"
                               Fill="#000"
                               Width="800"
                               Height="{StaticResource LogicalSizeWidth}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" RenderTransformOrigin="0%,0%">
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="5"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <Image x:Name="StartMenu_ArcademiaLogo"
                           Source="/Assets/Images/Arcademia_Logo.png"
                           Width="594"
                           Height="298"
                           Stretch="Uniform"/>

                    <TextBlock x:Name="PressStartText"
                               Text="PRESS START"
                               FontFamily="{StaticResource EarlyGameBoy}"
                               FontSize="42"
                               Foreground="White"
                               Height="44"
                               Width="480"/>
                </Canvas>
            </Grid>

            <!-- Home Menu -->
            <Grid x:Name="HomeMenu" IsVisible="False"
                  Width="{StaticResource LogicalSizeWidth}"
                  Height="{StaticResource LogicalSizeHeight}">
                <Grid.Background>
                    <SolidColorBrush Color="Black"/>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="11*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="2.5*"/>
                        <RowDefinition Height="0.5*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="2.5*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1"
                          Margin="100,0">
                        <Image x:Name="HomeMenu_ArcademiaLogo"
                                Source="/Assets/Images/Arcademia_Logo.png"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="100,0">
                            <TextBlock x:Name="GameLibraryText"
                                       Text="Games Library"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       FontSize="18"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Grid.Row="1"
                              Margin="100,0">
                            <TextBlock x:Name="InputMenuText"
                                       Text="Input Tester"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       FontSize="18"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Grid.Row="2"
                              Margin="100,0">
                            <TextBlock x:Name="AboutText"
                                       Text="About"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       FontSize="18"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Grid.Row="3"
                              Margin="100,0">
                            <TextBlock x:Name="ExitText"
                                       Text="Exit"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       FontSize="18"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="4"
                          Margin="75,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="Controls"
                                       Foreground="White"
                                       FontSize="18"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Border BorderThickness="0,0,1,0">
                                    <Border.BorderBrush>
                                        <DrawingBrush DestinationRect="0,0,16,8" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#777">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,50,50"/>
                                                                <RectangleGeometry Rect="50,50,50,50"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Up Control -->
                                        <Grid Grid.Row="0"
                                              Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="5*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Up Key -->
                                            <Grid Grid.Column="0"
                                                  Margin="5,0">
                                                <Ellipse Fill="#777"
                                                         Height="40"
                                                         Width="40"
                                                         StrokeThickness="2"
                                                         Stroke="#777"
                                                         Margin="2,3,0,0"/>
                                                <Ellipse Fill="#000"
                                                         Height="38"
                                                         Width="38"
                                                         StrokeThickness="4"
                                                         Stroke="#777"
                                                         Margin="0,0,2,3"/>
                                                <LayoutTransformControl Margin="0,0,10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <LayoutTransformControl.LayoutTransform>
                                                        <RotateTransform Angle="270"/>
                                                    </LayoutTransformControl.LayoutTransform>
                                                    <TextBlock Text="&#10132;" Foreground="White" FontSize="24" FontFamily="{StaticResource EarlyGameBoy}"/>
                                                </LayoutTransformControl>
                                            </Grid>
                                            <!-- Up Text -->
                                            <Grid Grid.Column="1"
                                                  Margin="10,0">
                                                <TextBlock Text="Up"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontFamily="{StaticResource EarlyGameBoy}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <!-- Down Control -->
                                        <Grid Grid.Row="1"
                                              Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="5*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Down Key -->
                                            <Grid Grid.Column="0">
                                                <Ellipse Fill="#777"
                                                         Height="40"
                                                         Width="40"
                                                         StrokeThickness="2"
                                                         Stroke="#777"
                                                         Margin="2,3,0,0"/>
                                                <Ellipse Fill="#000"
                                                         Height="38"
                                                         Width="38"
                                                         StrokeThickness="4"
                                                         Stroke="#777"
                                                         Margin="0,0,2,3"/>
                                                <LayoutTransformControl Margin="0,0,-4,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <LayoutTransformControl.LayoutTransform>
                                                        <RotateTransform Angle="90"/>
                                                    </LayoutTransformControl.LayoutTransform>
                                                    <TextBlock Text="&#10132;" Foreground="White" FontSize="24" FontFamily="{StaticResource EarlyGameBoy}"/>
                                                </LayoutTransformControl>
                                            </Grid>
                                            <!-- Down Text -->
                                            <Grid Grid.Column="1"
                                                  Margin="10,0">
                                                <TextBlock Text="Down"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontFamily="{StaticResource EarlyGameBoy}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Border BorderThickness="1,0,0,0">
                                    <Border.BorderBrush>
                                        <DrawingBrush DestinationRect="0,0,8,8" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#777">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,50,50"/>
                                                                <RectangleGeometry Rect="50,50,50,50"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Start Control -->
                                        <Grid Grid.Row="0"
                                              Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="5*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Start Key -->
                                            <Grid Grid.Column="0">
                                                <Ellipse Fill="#FF217300"
                                                         Height="40"
                                                         Width="40"
                                                         StrokeThickness="5"
                                                         Stroke="#FF217300"
                                                         Margin="2,3,0,0"/>
                                                <Ellipse Fill="#FF42E600"
                                                         Height="38"
                                                         Width="38"
                                                         StrokeThickness="3"
                                                         Stroke="#FF42E600"
                                                         Margin="0,0,2,3"/>
                                                <TextBlock Text="A"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           FontFamily="{StaticResource EarlyGameBoy}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,2,4"/>
                                            </Grid>
                                            <!-- Start Text -->
                                            <Grid Grid.Column="1"
                                                  Margin="10,0">
                                                <TextBlock Text="Select"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontFamily="{StaticResource EarlyGameBoy}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="5"
                          Margin="74,25">
                        <TextBlock x:Name="Copyright"
                                   Text="Copyright ©️ 2018 - Now Arcademia, All rights reserved."
                                   Foreground="#777"
                                   FontSize="14"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </Grid>
                    <Grid Grid.Row="6"
                          Margin="50,25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="[Arcademia-Launcher]"
                                   Foreground="#777"
                                   FontSize="8"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="1"
                                   Text="  Developed by Malphatt for Arcademia"
                                   Foreground="#777"
                                   FontSize="8"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="5"
                                   Text="{x:Static local:AppInfo.VersionLabel}"
                                   Foreground="#777"
                                   FontSize="8"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
                <Grid x:Name="HomeMenuImageArea"
                      ClipToBounds="True"
                      Grid.Column="1">
                    <uc:HomeThumbnailScroll x:Name="HomeThumbnailScroll"/>
                    <Canvas>
                        <!-- Lock width of Credits Panel to the Width of HomeMenuImageArea -->
                        <Grid x:Name="CreditsPanel" IsVisible="False"
                              Canvas.Top="{StaticResource LogicalSizeHeight}"
                              Width="{Binding #HomeMenuImageArea.Bounds.Width}"
                              Margin="50,0,0,0"/>
                        <!-- Logos (Unused)
                        <Image x:Name="UoL_Logo"
                               Source="/Assets/Images/uolwhite.png" IsVisible="False"
                               Opacity="0.8"
                               Width="150"
                               Canvas.Bottom="10"
                               Canvas.Right="10"
                               Stretch="Uniform"/>
                        <Image x:Name="intlab_Logo"
                               Source="/Assets/Images/intlab.png" IsVisible="False"
                               Opacity="0.8"
                               Width="150"
                               Canvas.Bottom="10"
                               Canvas.Right="170"
                               Stretch="Uniform"/>
                        <Image x:Name="CSS_Logo"
                               Source="/Assets/Images/css.png" IsVisible="False"
                               Opacity="0.8"
                               Width="150"
                               Canvas.Bottom="10"
                               Canvas.Right="330"
                               Stretch="Uniform"/>
                        -->
                    </Canvas>
                </Grid>
            </Grid>

            <!-- Input Tester -->
            <Grid x:Name="InputMenu" IsVisible="False"
                  Width="{StaticResource LogicalSizeWidth}"
                  Height="{StaticResource LogicalSizeHeight}">
                <Grid.Background>
                    <SolidColorBrush Color="Black"/>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="Hold Exit to go back"
                               Foreground="White"
                               FontSize="20"
                               FontFamily="{StaticResource EarlyGameBoy}"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="20"/>
                    <TextBlock x:Name="InputMenu_HoldBackCountdownText"
                               Text=""
                               Foreground="Red"
                               FontSize="20"
                               FontFamily="{StaticResource EarlyGameBoy}"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="20,50"/>
                    <TextBlock Text="Input Tester"
                               Foreground="White"
                               FontSize="40"
                               FontFamily="{StaticResource EarlyGameBoy}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          Margin="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Ellipse x:Name="InputMenu_P1_Exit"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="0,0,175,325"/>
                            <TextBlock x:Name="InputMenu_P1_ExitText"
                                       Text="Exit"
                                       Foreground="White"
                                       FontSize="20"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,175,450"/>
                            <Ellipse x:Name="InputMenu_P1_Start"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="175,0,0,325"/>
                            <TextBlock x:Name="InputMenu_P1_StartText"
                                       Text="Start"
                                       Foreground="White"
                                       FontSize="20"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="175,0,0,450"/>
                            <Ellipse x:Name="InputMenu_P1_Joy"
                                     Fill="#F00"
                                     Height="100"
                                     Width="100"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="0,0,0,0"/>
                            <LayoutTransformControl Margin="5,0,0,200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock x:Name="InputMenu_P1_Joy_UpText" Text=">" Foreground="White" FontSize="50" FontFamily="{StaticResource EarlyGameBoy}"/>
                            </LayoutTransformControl>
                            <TextBlock x:Name="InputMenu_P1_Joy_RightText"
                                       Text=">"
                                       Foreground="White"
                                       FontSize="50"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="200,5,0,0"/>
                            <LayoutTransformControl Margin="0,200,8,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock x:Name="InputMenu_P1_Joy_DownText" Text=">" Foreground="White" FontSize="50" FontFamily="{StaticResource EarlyGameBoy}"/>
                            </LayoutTransformControl>
                            <LayoutTransformControl Margin="0,0,200,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="180"/>
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock x:Name="InputMenu_P1_Joy_LeftText" Text=">" Foreground="White" FontSize="50" FontFamily="{StaticResource EarlyGameBoy}"/>
                            </LayoutTransformControl>
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock Text="Player 1"
                                       Foreground="White"
                                       FontSize="28"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Center"
                                       Margin="20"/>
                            <Ellipse x:Name="InputMenu_P1_A"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="0,0,225,150"/>
                            <TextBlock x:Name="InputMenu_P1_AText"
                                       Text="A"
                                       Foreground="White"
                                       FontSize="20"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,225,275"/>
                            <Ellipse x:Name="InputMenu_P1_B"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="0,0,0,150"/>
                            <TextBlock x:Name="InputMenu_P1_BText"
                                       Text="B"
                                       Foreground="White"
                                       FontSize="20"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,275"/>
                            <Ellipse x:Name="InputMenu_P1_C"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="225,0,0,150"/>
                            <TextBlock x:Name="InputMenu_P1_CText"
                                       Text="C"
                                       Foreground="White"
                                       FontSize="20"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="225,0,0,275"/>
                            <Ellipse x:Name="InputMenu_P1_D"
                                     Fill="#F00"
                                     Height="75"
                                     Width="75"
                                     StrokeThickness="5"
                                     Stroke="#B00"
                                     Margin="0,150,225,0"/>
                            <TextBlock x:Name="InputMenu_P1_DText"
                                       Text="D"
                                       Foreground="White"
                                       FontSize="20"
                                       FontFamily="{StaticResource EarlyGameBoy}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,25,225,0"/>
                            <Ellipse x:Name="InputMenu_P1_E"
                                     Fill="#F00"
