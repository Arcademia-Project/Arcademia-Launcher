            <!-- Selection Menu -->
            <Grid x:Name="SelectionMenu" IsVisible="False"
                  Width="{StaticResource LogicalSizeWidth}"
                  Height="{StaticResource LogicalSizeHeight}">
                <Grid.Background>
                    <SolidColorBrush Color="Black"/>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border BorderThickness="0,0,3,0"
                        BorderBrush="#777">
                    <Grid Grid.Column="0"
                          Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="11*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="5*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="50,50,50,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1.5*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                  HorizontalAlignment="Left">
                                <ToggleButton x:Name="BackFromGameLibraryButton"
                                              Content="    Go Back"
                                              Click="BackFromGameLibraryButton_Click"
                                              Theme="{StaticResource ToggleButtonStyle}"
                                              FontSize="18"
                                              Background="Transparent"
                                              Foreground="White"
                                              BorderBrush="White"
                                              BorderThickness="3"
                                              Width="180"/>
                                <LayoutTransformControl Margin="0,0,130,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <RotateTransform Angle="180"/>
                                    </LayoutTransformControl.LayoutTransform>
                                    <TextBlock Text="&#10132;" Foreground="White" FontSize="28" FontFamily="{StaticResource EarlyGameBoy}"/>
                                </LayoutTransformControl>
                            </Grid>
                            <Grid Grid.Row="1"
                                  Margin="50,10,0,0">
                                <TextBlock x:Name="SelectionMenuHeaderText"
                                           Text="Games"
                                           Foreground="White"
                                           FontSize="32"
                                           FontFamily="{StaticResource EarlyGameBoy}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>
                        <Image Grid.Row="1"
                               x:Name="ScrollArrow_Up"
                               Source="/Assets/Images/Scroll-Arrow.gif"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"
                               RenderTransformOrigin="50%,50%"
                               gif:AnimationBehavior.SourceUri="/Assets/Images/Scroll-Arrow.gif">
                            <Image.RenderTransform>
                                <RotateTransform Angle="180"/>
                            </Image.RenderTransform>
                        </Image>
                        <Grid Grid.Row="2"
                              Margin="150,0,150,0">
                            <UniformGrid Rows="5"
                                    Columns="3">
                                <!-- TILE 0 -->
                                <Panel Margin="5"
                                       ClipToBounds="True">
