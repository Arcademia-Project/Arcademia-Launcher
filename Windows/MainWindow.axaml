                                               Content="Game 1"
                                               Foreground="White"
                                               FontSize="24"
                                               HorizontalContentAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,10"
                                               Height="45"
                                               Width="280"
                                               FontFamily="{StaticResource EarlyGameBoy}"/>
                                    </Grid>
                                </Panel>
