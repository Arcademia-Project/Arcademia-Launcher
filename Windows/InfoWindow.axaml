<Window x:Class="ArcademiaGameLauncher.Windows.InfoWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:ArcademiaGameLauncher.Utils"
        xmlns:local="clr-namespace:ArcademiaGameLauncher"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        CanResize="False"
        Title="InfoWindow"
        Height="600"
        Width="1000"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

        <!-- Declare the Launcher Version, Global Font and ToggleButton style -->
        <Window.Resources>
                <FontFamily x:Key="EarlyGameBoy">avares://Arcademia-Launcher/Fonts#Press Start 2P</FontFamily>
        </Window.Resources>
        <StackPanel Background="Black">

                <!-- Force Exit Menu -->
                <Grid x:Name="ForceExitMenu" IsVisible="False"
                      Width="1000"
                      Height="600">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1"
                                   x:Name="ForceExitTitle"
                                   Text="Closing GameName..."
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="3"
                                   Text="Release To Cancel"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="36"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="4"
                                   x:Name="ForceExitCountdown"
                                   Text="0.0"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="64"
                                   Foreground="Red"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                </Grid>

                <!-- Idle Menu -->
                <Grid x:Name="IdleMenu" IsVisible="False"
                      Width="1000"
                      Height="600">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1"
                                   Text="No Recent Input Detected"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2"
                                   x:Name="IdleTitle"
                                   Text="Closing GameName..."
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="28"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="4"
                                   Text="Press Any Key To Abort"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="36"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="5"
                                   x:Name="IdleCountdown"
                                   Text="0.0"
                                   FontFamily="{StaticResource EarlyGameBoy}"
                                   FontSize="64"
                                   Foreground="Red"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                </Grid>
        </StackPanel>
</Window>
