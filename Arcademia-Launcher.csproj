<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ArcademiaGameLauncher</RootNamespace>
    <AssemblyName>Arcademia-Launcher</AssemblyName>
    <LegacyExeName>Research-Arcade-Launcher</LegacyExeName>
    <Version>2.11.0-26</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Images\Arcademia_Favicon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="packages/**;state/**" />
    <None Remove="packages/**;state/**" />
    <AvaloniaResource Include="Fonts\**" />
    <AvaloniaResource Include="Assets\Images\**" />
    <EmbeddedResource Include="Assets\Sounds\**" />
    <EmbeddedResource Include="Assets\json\ButtonConfig.json" />
    <EmbeddedResource Include="Assets\json\Credits.json" />
    <EmbeddedResource Include="Assets\json\emojis.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.5" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
    <PackageReference Include="NLayer.NAudioSupport" Version="3.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SocketIO.Serializer.Core" Version="3.1.2" />
    <PackageReference Include="SocketIO.Serializer.SystemTextJson" Version="3.1.2" />
    <PackageReference Include="SocketIOClient" Version="4.0.5" />
    <PackageReference Include="SocketIOClient.Newtonsoft.Json" Version="3.0.7" />
    <PackageReference Include="Ultz.Native.SDL" Version="2.32.10" />
  </ItemGroup>
  <Target Name="BuildWineBridge" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <MakeDir Directories="$(PublishDir)WineBridge" />
    <Exec Command="x86_64-w64-mingw32-gcc -O2 -s -municode -static -o &quot;$(PublishDir)WineBridge/Arcademia-WineBridge.exe&quot; &quot;$(MSBuildProjectDirectory)/WineBridge/Arcademia-WineBridge.c&quot; -lws2_32" />
  </Target>
  <Target Name="CopyLegacyExeAfterBuild" AfterTargets="Build" Condition="Exists('$(OutDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).exe" DestinationFiles="$(OutDir)$(LegacyExeName).exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyLegacyExeAfterPublish" AfterTargets="Publish" Condition="Exists('$(PublishDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(LegacyExeName).exe" SkipUnchangedFiles="true" />
  </Target>
</Project>
